{{define "OnboardingCode"}}
    {{template "header"}}
    {{- /*gotype: go.wdy.de/nago/application/user/tplmail.OnboardingCodeModel*/ -}}
                    <tr>
                        <td class="wrapper">
                            <p>Hallo,</p>

                            <p>für {{.ApplicationName}} wurde die Einrichtung des ersten Kontos mit dieser E-Mail-Adresse
                                gestartet. Gib den folgenden Code auf der Einrichtungsseite ein:</p>

                            <p style="font-size: 28px; font-weight: bold; letter-spacing: 6px;">{{.Code}}</p>

                            <p>Der Code ist {{.ValidMinutes}} Minuten gültig. Falls Du die Einrichtung nicht gestartet
                                hast, kannst Du diese E-Mail ignorieren.</p>
                        </td>
                    </tr>

    {{template "footer"}}
{{end}}

{{define "OnboardingCodeSubject" -}}
    Dein Einrichtungscode für {{.ApplicationName}}: {{.Code}}
{{- end}}
